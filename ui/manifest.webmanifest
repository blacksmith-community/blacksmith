{
  "id": "/",
  "name": "Blacksmith Management Console",
  "short_name": "Blacksmith",
  "description": "Manage service instances, deployments, and certificates.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f2ec",
  "theme_color": "#f5f2ec",
  "icons": [
    {
      "src": "/assets/brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Blacksmith Broker",
      "short_name": "Broker",
      "description": "Broker summary, plans, tasks, and settings",
      "url": "/#/broker/summary",
      "icons": [
        {
          "src": "/assets/brand/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Service Instances",
      "short_name": "Instances",
      "description": "Every service instance the broker manages",
      "url": "/#/instances",
      "icons": [
        {
          "src": "/assets/brand/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Certificates",
      "short_name": "Certificates",
      "description": "Certificate inventory and expiry",
      "url": "/#/certificates",
      "icons": [
        {
          "src": "/assets/brand/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Batch Operations",
      "short_name": "Batch",
      "description": "Upgrade, rotate, converge, and run commands across instances",
      "url": "/#/batch/new/upgrade/operation",
      "icons": [
        {
          "src": "/assets/brand/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
