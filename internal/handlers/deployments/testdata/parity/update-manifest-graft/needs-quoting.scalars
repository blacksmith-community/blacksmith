$["properties"]["apos"]	plain	!!str	string	"it's"
$["properties"]["at"]#key	plain	!!str	string	"at"
$["properties"]["at"]	single	!!str	string	"@x"
$["properties"]["backtick"]#key	plain	!!str	string	"backtick"
$["properties"]["backtick"]	single	!!str	string	"`x"
$["properties"]["bang"]#key	plain	!!str	string	"bang"
$["properties"]["bang"]	single	!!str	string	"!x"
$["properties"]["brace"]#key	plain	!!str	string	"brace"
$["properties"]["brace"]	single	!!str	string	"{x}"
$["properties"]["bracket"]#key	plain	!!str	string	"bracket"
$["properties"]["bracket"]	single	!!str	string	"[x]"
$["properties"]["colon"]#key	plain	!!str	string	"colon"
$["properties"]["colon"]	single	!!str	string	"a: b"
$["properties"]["dash"]#key	plain	!!str	string	"dash"
$["properties"]["dash"]	single	!!str	string	"- x"
$["properties"]["emoji"]#key	plain	!!str	string	"emoji"
$["properties"]["emoji"]	double	!!str	string	"😀"
$["properties"]["hash"]#key	plain	!!str	string	"hash"
$["properties"]["hash"]	single	!!str	string	"a #b"
$["properties"]["lead-colon"]#key	plain	!!str	string	"lead-colon"
$["properties"]["lead-colon"]	double	!!str	string	":x"
$["properties"]["lead-space"]#key	plain	!!str	string	"lead-space"
$["properties"]["lead-space"]	single	!!str	string	" x"
$["properties"]["pct"]#key	plain	!!str	string	"pct"
$["properties"]["pct"]	single	!!str	string	"%x"
$["properties"]["quote"]#key	plain	!!str	string	"quote"
$["properties"]["quote"]	plain	!!str	string	"say \"hi\""
$["properties"]["star"]#key	plain	!!str	string	"star"
$["properties"]["star"]	single	!!str	string	"*x"
$["properties"]["tab"]#key	plain	!!str	string	"tab"
$["properties"]["tab"]	double	!!str	string	"a\tb"
$["properties"]["trail-space"]#key	plain	!!str	string	"trail-space"
