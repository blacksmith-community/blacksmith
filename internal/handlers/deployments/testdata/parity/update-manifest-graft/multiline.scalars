$["name"]#key	plain	!!str	string	"name"
$["name"]	plain	!!str	string	"parity"
$["properties"]#key	plain	!!str	string	"properties"
$["properties"]["blank"]#key	plain	!!str	string	"blank"
$["properties"]["blank"]	literal	!!str	string	"a\n\nb"
$["properties"]["cert"]#key	plain	!!str	string	"cert"
$["properties"]["cert"]	literal	!!str	string	"-----BEGIN CERTIFICATE-----\nFIXTURE-PLACEHOLDER\n-----END CERTIFICATE-----\n"
$["properties"]["cr"]#key	plain	!!str	string	"cr"
$["properties"]["cr"]	double	!!str	string	"a\r\nb"
$["properties"]["trailing"]#key	plain	!!str	string	"trailing"
$["properties"]["trailing"]	literal	!!str	string	"line1\n"
$["properties"]["two"]#key	plain	!!str	string	"two"
$["properties"]["two"]	literal	!!str	string	"line1\nline2"
