$.text	string	"addons:\n    - include:\n        jobs:\n            - name: route_registrar\n              release: routing\n      jobs:\n        - name: bosh-dns-aliases\n          properties:\n            aliases:\n                - domain: nats.service.cf.internal\n                  targets:\n                    - deployment: fixture-env-cf\n                      domain: bosh\n                      instance_group: nats\n                      network: fixture-core-network\n                      query: '*'\n                - domain: _.nats.service.cf.internal\n                  targets:\n                    - deployment: fixture-env-cf\n                      domain: bosh\n                      instance_group: nats\n                      network: fixture-core-network\n                      query: _\n                - domain: log-cache.service.cf.internal\n                  targets:\n                    - deployment: fixture-env-cf\n                      domain: bosh\n                      instance_group: log-cache\n                      network: fixture-core-network\n                      query: '*'\n                - domain: _.log-cache.service.cf.internal\n                  targets:\n                    - deployment: fixture-env-cf\n                      domain: bosh\n                      instance_group: log-cache\n                      network: fixture-core-network\n                      query: _\n          release: bosh-dns-aliases\n      name: bosh-dns-aliases\ndirector_uuid: 00000000-0000-4000-8000-000000000000\nfeatures:\n    use_dns_addresses: true\ninstance_groups:\n    - azs:\n        - z1\n      instances: 1\n      jobs:\n        - consumes:\n            rabbitmq-servers:\n                from: rabbitmq-servers\n                ip_addresses: false\n          custom_provider_definitions:\n            - name: rabbitmq-san\n              type: address\n            - name: rabbitmq-alias-domain\n              type: placeholder\n          name: rabbitmq\n          properties:\n            erlang:\n                cookie: \"1e3\"\n            plugins: []\n            rabbitmq:\n                admin:\n                    pass: :leading-colon\n                    user: |\n                        -----BEGIN CERTIFICATE-----\n                        FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                        -----END CERTIFICATE-----\n                app:\n                    pass: \"yes\"\n                    user: \"y\"\n                monitoring:\n                    pass: \"0755\"\n                    user: \"2026-01-02\"\n                network: rabbitmq-service\n                plan: standalone\n                tls:\n                    dual-mode: false\n                    enabled: false\n                vhost: parity-rabbitmq-dashboard-registration\n          provides:\n            rabbitmq-alias-domain:\n                aliases:\n                    - domain: _.rabbitmq_standalone.bosh\n                      placeholder_type: uuid\n            rabbitmq-san:\n                as: rabbitmq-san\n                ip_addresses: false\n            rabbitmq-servers:\n                as: rabbitmq-servers\n                ip_addresses: false\n          release: rabbitmq-forge\n        - consumes:\n            binding_cache:\n                deployment: fixture-env-cf\n                from: binding_cache\n          name: loggr-syslog-agent\n          properties:\n            cache:\n                tls:\n                    ca_cert: |+\n                        -----BEGIN CERTIFICATE-----\n                        FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                        -----END CERTIFICATE-----\n\n                    cert: |+\n                        -----BEGIN CERTIFICATE-----\n                        FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                        -----END CERTIFICATE-----\n\n                    cn: binding-cache\n                    key: |+\n                        -----BEGIN PRIVATE KEY-----\n                        FIXTURE-PLACEHOLDER-NOT-A-REAL-KEY\n                        -----END PRIVATE KEY-----\n\n            drain_ca_cert: |+\n                -----BEGIN CERTIFICATE-----\n                FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                -----END CERTIFICATE-----\n\n            metrics:\n                ca_cert: |+\n                    -----BEGIN CERTIFICATE-----\n                    FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                    -----END CERTIFICATE-----\n\n                cert: |+\n                    -----BEGIN CERTIFICATE-----\n                    FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                    -----END CERTIFICATE-----\n\n                key: |+\n                    -----BEGIN PRIVATE KEY-----\n                    FIXTURE-PLACEHOLDER-NOT-A-REAL-KEY\n                    -----END PRIVATE KEY-----\n\n                server_name: syslog_agent_metrics\n            port: 3460\n            tls:\n                ca_cert: |+\n                    -----BEGIN CERTIFICATE-----\n                    FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                    -----END CERTIFICATE-----\n\n                cert: |+\n                    -----BEGIN CERTIFICATE-----\n                    FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                    -----END CERTIFICATE-----\n\n                key: |+\n                    -----BEGIN PRIVATE KEY-----\n                    FIXTURE-PLACEHOLDER-NOT-A-REAL-KEY\n                    -----END PRIVATE KEY-----\n\n          release: loggregator-agent\n        - name: loggr-forwarder-agent\n          properties:\n            metrics:\n                ca_cert: |+\n                    -----BEGIN CERTIFICATE-----\n                    FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                    -----END CERTIFICATE-----\n\n                cert: |+\n                    -----BEGIN CERTIFICATE-----\n                    FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                    -----END CERTIFICATE-----\n\n                key: |+\n                    -----BEGIN PRIVATE KEY-----\n                    FIXTURE-PLACEHOLDER-NOT-A-REAL-KEY\n                    -----END PRIVATE KEY-----\n\n                server_name: forwarder_agent_metrics\n            tls:\n                ca_cert: |+\n                    -----BEGIN CERTIFICATE-----\n                    FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                    -----END CERTIFICATE-----\n\n                cert: |+\n                    -----BEGIN CERTIFICATE-----\n                    FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                    -----END CERTIFICATE-----\n\n                key: |+\n                    -----BEGIN PRIVATE KEY-----\n                    FIXTURE-PLACEHOLDER-NOT-A-REAL-KEY\n                    -----END PRIVATE KEY-----\n\n          release: loggregator-agent\n        - custom_provider_definitions:\n            - name: rabbitmq-emitter\n              type: address\n          name: rabbitmq-metrics-emitter\n          properties:\n            rabbitmq_metrics_emitter:\n                cloud_foundry:\n                    api: https://api.sys.fixture.example\n                    password: fixture-password-not-real\n                    skip_ssl_validation: false\n                    username: fixture-admin\n                loggregator:\n                    tls:\n                        ca_cert: |+\n                            -----BEGIN CERTIFICATE-----\n                            FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                            -----END CERTIFICATE-----\n\n                        cert: |+\n                            -----BEGIN CERTIFICATE-----\n                            FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                            -----END CERTIFICATE-----\n\n                        key: |+\n                            -----BEGIN PRIVATE KEY-----\n                            FIXTURE-PLACEHOLDER-NOT-A-REAL-KEY\n                            -----END PRIVATE KEY-----\n\n                rmq_management:\n                    endpoint: https://localhost:15671/api\n                    password: :leading-colon\n                    skip_ssl_validation: true\n                    user: |\n                        -----BEGIN CERTIFICATE-----\n                        FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                        -----END CERTIFICATE-----\n          provides:\n            rabbitmq-emitter:\n                as: rabbitmq-emitter\n                ip_addresses: false\n          release: rabbitmq-metrics-emitter\n        - consumes:\n            nats-tls:\n                deployment: fixture-env-cf\n                from: nats-tls\n          name: route_registrar\n          properties:\n            nats:\n                tls:\n                    client_cert: ((/fixture-env-bosh/fixture-env-cf/nats_client_cert.certificate))\n                    client_key: ((/fixture-env-bosh/fixture-env-cf/nats_client_cert.private_key))\n                    enabled: true\n            route_registrar:\n                logging_level: debug\n                routes:\n                    - name: rabbitmq-standalone-parity-rabbitmq-dashboard-registration\n                      port: 15672\n                      registration_interval: 10s\n                      uris:\n                        - rabbitmq-standalone-parity-rabbitmq-dashboard-registration.sys.fixture.example\n          release: routing\n        - name: bpm\n          release: bpm\n      name: standalone\n      networks:\n        - name: rabbitmq-service\n      stemcell: default\n      vm_type: default\nmeta:\n    azs:\n        - z1\n    bosh_env: fixture-env\n    cf:\n        api_url: https://api.sys.fixture.example\n        deployment_name: fixture-env-cf\n        exodus_path: secret/exodus/fixture-env/cf\n        password: fixture-password-not-real\n        system_domain: sys.fixture.example\n        username: fixture-admin\n    disk_config: {}\n    environment: fixture-env\n    erlang_cookie: \"1e3\"\n    instances: 1\n    mgmt_host: localhost\n    mgmt_port: 15671\n    mgmt_scheme: https\n    mgmt_ssl: true\n    net: rabbitmq-service\n    params:\n        instance_id: parity-rabbitmq-dashboard-registration\n    password: :leading-colon\n    password-app: \"yes\"\n    password-monitoring: \"0755\"\n    persistent: false\n    plugins: []\n    size: default\n    username: |\n        -----BEGIN CERTIFICATE-----\n        FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n        -----END CERTIFICATE-----\n    username-app: \"y\"\n    username-monitoring: \"2026-01-02\"\nname: rabbitmq-standalone-parity-rabbitmq-dashboard-registration\nparams:\n    cf:\n        core_network: fixture-core-network\nreleases:\n    - name: rabbitmq-forge\n      version: latest\n    - name: routing\n      sha1: 69690159842feda278a45ca17484ea055432086d\n      url: https://bosh.io/d/github.com/cloudfoundry/routing-release?v=0.338.0\n      version: 0.338.0\n    - name: bpm\n      sha1: 00223345c70d5629d35008e88c42bf4482bdf766\n      url: https://bosh.io/d/github.com/cloudfoundry/bpm-release?v=1.4.20\n      version: 1.4.20\n    - name: bosh-dns-aliases\n      sha1: 55b3dced813ff9ed92a05cda02156e4b5604b273\n      url: https://bosh.io/d/github.com/cloudfoundry/bosh-dns-aliases-release?v=0.0.4\n      version: 0.0.4\n    - name: loggregator-agent\n      sha1: c0871307d993aa1766982b04f312affa83bce926\n      url: https://bosh.io/d/github.com/cloudfoundry/loggregator-agent-release?v=8.3.8\n      version: 8.3.8\n    - name: rabbitmq-metrics-emitter\n      sha1: 05afc6f3559f45e0696c6a3760242045640e0df8\n      url: https://github.com/cloudfoundry-community/rabbitmq-metrics-emitter-release/releases/download/v0.4.1/rabbitmq-metrics-emitter-0.4.1.tgz\n      version: 0.4.1\nstemcells:\n    - alias: default\n      os: ubuntu-jammy\n      version: latest\nupdate:\n    canaries: 1\n    canary_watch_time: 1000-30000\n    max_in_flight: 1\n    update_watch_tim