$.text	string	"director_uuid: 00000000-0000-4000-8000-000000000000\nfeatures:\n    randomize_az_placement: true\ninstance_groups:\n    - azs:\n        - z1\n      instances: 1\n      jobs:\n        - name: bpm\n          release: bpm\n        - custom_provider_definitions:\n            - name: redis-san\n              type: address\n            - name: redis-alias-domain\n              type: placeholder\n          name: standalone-6\n          properties:\n            auth:\n                password: \"yes\"\n            client:\n                connections: 10000\n                tcpkeepalive: 300\n                timeout: 0\n            lua:\n                scripting-enabled: true\n            persistent: false\n            redis:\n                auto-aof-rewrite-min-size: 64mb\n                auto-aof-rewrite-percentage: 100\n                maxmemory: 0\n                maxmemory-policy: allkeys-lru\n                no-appendfsync-on-rewrite: false\n                notify-keyspace-events: KEA\n                slowlog-log-slower-than: 10000\n                slowlog-max-len: 128\n                tls:\n                    ca: |\n                        -----BEGIN CERTIFICATE-----\n                        FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                        -----END CERTIFICATE-----\n                    ca_cert: ((redis_standalone_crt.certificate))\n                    ca_key: ((redis_standalone_crt.private_key))\n                    dual-mode: true\n                    enabled: true\n          provides:\n            redis-alias-domain:\n                aliases:\n                    - domain: _.redis_standalone.bosh\n                      placeholder_type: uuid\n            redis-san:\n                as: redis-san\n                ip_addresses: false\n          release: redis-forge\n      name: standalone\n      networks:\n        - name: redis-service\n      stemcell: default\n      vm_type: default\nmeta:\n    bosh_env: fixture-env\n    default:\n        azs:\n            - z1\n    disk_config: {}\n    environment: fixture-env\n    net: redis-service\n    params:\n        instance_id: parity-redis-dual-mode\n        maxmemory-policy: allkeys-lru\n        notify-keyspace-events: KEA\n        slowlog-log-slower-than: 10000\n        slowlog-max-len: 128\n    password: \"yes\"\n    persistent: false\n    redis:\n        tls:\n            ca: |4+\n                -----BEGIN CERTIFICATE-----\n                FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                -----END CERTIFICATE-----\n\n            ca_cert: |4+\n                -----BEGIN CERTIFICATE-----\n                FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                -----END CERTIFICATE-----\n\n            ca_key: |4+\n                -----BEGIN PRIVATE KEY-----\n                FIXTURE-PLACEHOLDER-NOT-A-REAL-KEY\n                -----END PRIVATE KEY-----\n\n            dual-mode: true\n            enabled: true\n    size: default\nname: redis-standalone-6-parity-redis-dual-mode\nreleases:\n    - name: redis-forge\n      version: latest\n    - name: bpm\n      sha1: sha256:1984129b352cd414e29a7dcffcf076049a776afa511cd44b587065f6e618cc6d\n      url: https://bosh.io/d/github.com/cloudfoundry/bpm-release?v=1.4.20\n      version: 1.4.20\nstemcells:\n    - alias: default\n      os: ubuntu-jammy\n      version: latest\nupdate:\n    canaries: 1\n    canary_watch_time: 1000-30000\n    max_in_flight: 10\n    update_watch_time: 1000-30000\nvariables:\n    - consumes:\n        alternative_name:\n            from: redis-san\n            properties:\n                wildcard: true\n      name: redis_standalone_crt\n      options:\n        ca: /fixture-env-bosh/fixture-env-blacksmith/blacksmith_services_ca\n        common_name: fixture-env-redis-standalone.bosh\n      type: certificate\n"
