$.text	string	"director_uuid: 00000000-0000-4000-8000-000000000000\nfeatures:\n    randomize_az_placement: true\ninstance_groups:\n    - azs:\n        - z1\n      instances: 1\n      jobs:\n        - name: bpm\n          release: bpm\n        - custom_provider_definitions:\n            - name: valkey-san\n              type: address\n            - name: valkey-alias-domain\n              type: placeholder\n          name: standalone\n          properties:\n            auth:\n                password: \"yes\"\n            client:\n                connections: 10000\n                tcpkeepalive: 300\n                timeout: 0\n            lua:\n                scripting-enabled: true\n            persistent: false\n            valkey:\n                auto-aof-rewrite-min-size: 64mb\n                auto-aof-rewrite-percentage: 100\n                maxmemory: 0\n                maxmemory-policy: allkeys-lru\n                no-appendfsync-on-rewrite: false\n                notify-keyspace-events: \"\"\n                slowlog-log-slower-than: 10000\n                slowlog-max-len: 128\n                tls:\n                    ca: |\n                        -----BEGIN CERTIFICATE-----\n                        FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                        -----END CERTIFICATE-----\n                    ca_cert: ((valkey_standalone_crt.certificate))\n                    ca_key: ((valkey_standalone_crt.private_key))\n                    dual-mode: false\n                    enabled: true\n                version: 8\n          provides:\n            valkey-alias-domain:\n                aliases:\n                    - domain: _.valkey_standalone.bosh\n                      placeholder_type: uuid\n            valkey-san:\n                as: valkey-san\n                ip_addresses: false\n          release: valkey-forge\n      name: standalone\n      networks:\n        - name: valkey-service\n      stemcell: default\n      vm_type: default\nmeta:\n    bosh_env: fixture-env\n    default:\n        azs:\n            - z1\n    disk_config: {}\n    environment: fixture-env\n    net: valkey-service\n    params:\n        instance_id: parity-valkey-tls\n    password: \"yes\"\n    persistent: false\n    size: default\n    valkey:\n        tls:\n            ca: |\n                #!/usr/bin/env ruby\n\n                -----BEGIN CERTIFICATE-----\n                FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                -----END CERTIFICATE-----\n            ca_cert: |\n                #!/usr/bin/env ruby\n\n                -----BEGIN CERTIFICATE-----\n                FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                -----END CERTIFICATE-----\n            ca_key: |\n                #!/usr/bin/env ruby\n\n                -----BEGIN PRIVATE KEY-----\n                FIXTURE-PLACEHOLDER-NOT-A-REAL-KEY\n                -----END PRIVATE KEY-----\n            enabled: true\n    valkey_version: 8\nname: valkey-standalone-parity-valkey-tls\nreleases:\n    - name: valkey-forge\n      version: latest\n    - name: bpm\n      sha1: sha256:7b445508d63d2171d892ba33f836087e1e519b9782f44c5fa5290323616ca8e6\n      url: https://bosh.io/d/github.com/cloudfoundry/bpm-release?v=1.4.41\n      version: 1.4.41\nstemcells:\n    - alias: default\n      os: ubuntu-noble\n      version: latest\nupdate:\n    canaries: 1\n    canary_watch_time: 1000-30000\n    max_in_flight: 10\n    update_watch_time: 1000-30000\nvariables:\n    - consumes:\n        alternative_name:\n            from: valkey-san\n            properties:\n                wildcard: true\n      name: valkey_standalone_crt\n      options:\n        ca: /fixture-env-bosh/fixture-env-blacksmith/blacksmith_services_ca\n        common_name: fixture-env-valkey-standalone.bosh\n      type: certificate\n"
