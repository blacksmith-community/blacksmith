$.text	string	"director_uuid: 00000000-0000-4000-8000-000000000000\nfeatures:\n    use_dns_addresses: true\ninstance_groups:\n    - azs:\n        - z1\n      instances: 6\n      jobs:\n        - name: bpm\n          release: bpm\n        - custom_provider_definitions:\n            - name: valkey-san\n              type: address\n            - name: valkey-alias-domain\n              type: placeholder\n          name: cluster\n          properties:\n            auth:\n                password: \"yes\"\n            client:\n                connections: 10000\n                tcpkeepalive: 300\n                timeout: 0\n            cluster:\n                masters: 3\n                replicas: 1\n            lua:\n                scripting-enabled: true\n            valkey:\n                auto-aof-rewrite-min-size: 64mb\n                auto-aof-rewrite-percentage: 100\n                maxmemory: 0\n                maxmemory-policy: allkeys-lru\n                no-appendfsync-on-rewrite: false\n                notify-keyspace-events: \"\"\n                slowlog-log-slower-than: 10000\n                slowlog-max-len: 128\n                tls:\n                    ca: |\n                        -----BEGIN CERTIFICATE-----\n                        FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                        -----END CERTIFICATE-----\n                    ca_cert: ((valkey_cluster_crt.certificate))\n                    ca_key: ((valkey_cluster_crt.private_key))\n                    dual-mode: false\n                    enabled: false\n                version: 8\n          provides:\n            valkey-alias-domain:\n                aliases:\n                    - domain: _.valkey_cluster.bosh\n                      placeholder_type: uuid\n            valkey-san:\n                as: valkey-san\n                ip_addresses: false\n          release: valkey-forge\n      name: node\n      networks:\n        - name: valkey-service\n      stemcell: default\n     