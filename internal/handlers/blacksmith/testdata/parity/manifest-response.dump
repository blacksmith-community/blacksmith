t:\n        azs:\n            - z1\n    disk_config: {}\n    environment: fixture-env\n    net: redis-service\n    params:\n        instance_id: parity-redis-base\n        maxmemory-policy: allkeys-lru\n        notify-keyspace-events: KEA\n        slowlog-log-slower-than: 10000\n        slowlog-max-len: 128\n    password: \"yes\"\n    persistent: false\n    size: default\nname: redis-standalone-6-parity-redis-base\nreleases:\n    - name: redis-forge\n      version: latest\n    - name: bpm\n      sha1: sha256:1984129b352cd414e29a7dcffcf076049a776afa511cd44b587065f6e618cc6d\n      url: https://bosh.io/d/github.com/cloudfoundry/bpm-release?v=1.4.20\n      version: 1.4.20\nstemcells:\n    - alias: default\n      os: ubuntu-jammy\n      version: latest\nupdate:\n    canaries: 1\n    canary_watch_time: 1000-30000\n    max_in_flight: 10\n    update_watch_time: 1000-30000\nvariables:\n    - consumes:\n        alternative_name:\n            from: redis-san\n            properties:\n                wildcard: true\n      name: redis_standalone_crt\n      options:\n        ca: /fixture-env-bosh/fixture-env-blacksmith/blacksmith_services_ca\n        common_name: fixture-env-redis-standalone.bosh\n      type: certificate\n"
