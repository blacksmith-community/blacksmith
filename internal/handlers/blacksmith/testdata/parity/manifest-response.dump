phemeral_disk_size: 20480\n        ram: 2048\nmeta:\n    azs:\n        - z1\n        - z2\n        - z3\n    default:\n        azs:\n            - z1\n            - z2\n            - z3\n    network: kubernetes-service\n    node_cpu: 2\n    node_ephemeral: 20480\n    node_mem: 2048\n    node_persistent: 20480\n    nodes: 3\n    params:\n        instance_id: parity-kubernetes-base\n    x509:\n        admin:\n            certificate: \"y\"\n            key: \"1e3\"\n        ca:\n            certificate: \"0755\"\n            key: \"2026-01-02\"\n        sa:\n            certificate: :leading-colon\n            key: |\n                -----BEGIN CERTIFICATE-----\n                FIXTURE-PLACEHOLDER-NOT-A-REAL-CERTIFICATE\n                -----END CERTIFICATE-----\nname: kubernetes-cluster-parity-kubernetes-base\nreleases:\n    - name: k8s\n      version: latest\nstemcells:\n    - alias: default\n      os: ubuntu-xenial\n      version: latest\nupdate:\n    canaries: 1\n    canary_watch_time: 1000-120000\n    max_in_flight: 1\n    serial: true\n    update_watch_time: 1000-120000\n"
