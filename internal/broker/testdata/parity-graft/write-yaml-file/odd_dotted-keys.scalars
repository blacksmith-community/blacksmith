$["name"]#key	plain	!!str	string	"name"
$["name"]	plain	!!str	string	"fixture"
$["properties"]#key	plain	!!str	string	"properties"
$["properties"][""]#key	double	!!str	string	""
$["properties"][""]	plain	!!str	string	"empty-key"
$["properties"]["a"]#key	plain	!!str	string	"a"
$["properties"]["a"]["b"]#key	plain	!!str	string	"b"
$["properties"]["a"]["b"]	plain	!!str	string	"nested"
$["properties"]["a.b"]#key	plain	!!str	string	"a.b"
$["properties"]["a.b"]	plain	!!str	string	"dotted"
$["properties"]["with space"]#key	plain	!!str	string	"with space"
$["properties"]["with space"]	plain	!!str	string	"spaced"
$["properties"]["x"]#key	plain	!!str	string	"x"
$["properties"]["x"][0]	plain	!!str	string	"listed"
$["properties"]["x[0]"]#key	plain	!!str	string	"x[0]"
$["properties"]["x[0]"]	plain	!!str	string	"bracketed"
