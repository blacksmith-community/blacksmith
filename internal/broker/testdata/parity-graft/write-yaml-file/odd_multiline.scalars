$["name"]#key	plain	!!str	string	"name"
$["name"]	plain	!!str	string	"fixture"
$["properties"]#key	plain	!!str	string	"properties"
$["properties"]["folded"]#key	plain	!!str	string	"folded"
$["properties"]["folded"]	literal	!!str	string	"folded one folded two\n"
$["properties"]["keep"]#key	plain	!!str	string	"keep"
$["properties"]["keep"]	literal	!!str	string	"kept\n\n"
$["properties"]["literal"]#key	plain	!!str	string	"literal"
$["properties"]["literal"]	literal	!!str	string	"line one\nline two\n"
$["properties"]["quoted"]#key	plain	!!str	string	"quoted"
$["properties"]["quoted"]	double	!!str	string	"tab\there\nnewline"
$["properties"]["strip"]#key	plain	!!str	string	"strip"
$["properties"]["strip"]	plain	!!str	string	"stripped"
